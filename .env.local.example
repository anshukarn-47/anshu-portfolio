# Copy to .env.local and fill in values from
# Supabase Dashboard > Project Settings > API

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Lab (server-only). Both are required for /ai-lab.
# Claude answers questions: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Voyage AI embeds content and questions: https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# Contact form (server-only). The form on /about appears once both are set.
# Resend sends the emails: https://resend.com/api-keys
RESEND_API_KEY=
# Where contact messages are delivered
CONTACT_TO_EMAIL=
# Optional sender. Defaults to Resend's test sender (onboarding@resend.dev), which can
# only deliver to your Resend account's own email; verify a domain in Resend to send from it.
# CONTACT_FROM_EMAIL="Portfolio <contact@yourdomain.com>"

# Analytics (optional). Page views are recorded in production only.
# ANALYTICS_SALT=           # secret for the daily anonymous visitor id; defaults to the service role key
# ANALYTICS_IN_DEV=1        # also record events from `npm run dev` (for testing)

# Optional AI Lab spend guards (defaults shown)
# AI_LAB_HOURLY_LIMIT=20    # questions per visitor per hour
# AI_LAB_DAILY_LIMIT=300    # questions across the whole site per day
# AI_LAB_VISITOR_SALT=      # salt for anonymous visitor ids; defaults to the service role key
